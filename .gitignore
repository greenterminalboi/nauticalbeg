# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Vite
.vite/
*.local

# Testing
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Env
.env
.env.*
!.env.example

# Editor/OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local sample save files a developer drops in for manual testing (large,
# user-provided). Real fixture files that ARE meant to be committed
# (constitution Principle II) live under tests/fixtures/ and are exempted
# below regardless of extension, once that extension is known.
/*.sav
/*.zip
/*.eu5

# Generated schema-mapping inventories (confirmed via a real run:
# 100MB+ each for a ~642MB save's full "1-1" inventory — far too large
# to commit). The fixture-based regression test already asserts the
# tool's exact output for the small committed fixture, so even that
# inventory isn't separately committed — every generated inventory here
# is a local, on-demand artifact.
/tools/schema-mapping/inventories/*
!/tools/schema-mapping/inventories/.gitkeep

# Rust build output for the EU5 melter crate (015). The built WASM is
# committed under src/parser/melter/generated/ instead.
/tools/eu5-melter/target/
*.rs.bk

# Local Cloudflare simulation state (wrangler pages dev, 017)
.wrangler/
