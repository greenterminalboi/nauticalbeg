+/// NauticalBeg patch (see PATCHED.md): a string from the save's lookup table
+/// can contain spaces or Clausewitz syntax characters (e.g. a custom country
+/// name like `Lil Israel`). Written unquoted, that produces
+/// `Custom_Name=Lil Israel`, which a text parser reads as `Custom_Name=Lil`
+/// plus a stray `Israel` token. Quote such strings; leave plain identifiers
+/// unquoted so output otherwise matches upstream byte-for-byte.
+fn write_lookup_str<W: Write>(wtr: &mut jomini::TextWriter<W>, s: &str) -> Result<(), jomini::Error> {
+    let needs_quote = s.is_empty()
+        || s.bytes()
+            .any(|b| b.is_ascii_whitespace() || matches!(b, b'=' | b'{' | b'}' | b'"' | b'#'));
+    if needs_quote {
+        wtr.write_quoted(s.as_bytes())
+    } else {
+        wtr.write_unquoted(s.as_bytes())
+    }
+}
