{
  "name": "nauticalbeg",
  "version": "1.0.0",
  "description": "Save-file analysis and visualization tool for Europa Universalis V",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:map": "tsx tools/map-generation/generate.ts",
    "generate:terrain": "tsx tools/map-generation/generate-terrain-lookup.ts",
    "schema-map": "tsx tools/schema-mapping/generate.ts",
    "generate:encyclopedia": "tsx tools/encyclopedia-scraping/generate.ts",
    "generate:ruler-names": "tsx tools/ruler-names-scraping/generate.ts",
    "generate:country-names": "tsx tools/country-names/generate.ts",
    "postinstall": "patch-package",
    "check:dist": "tsx tools/check-dist/check-dist.ts dist",
    "build:melter": "bash tools/eu5-melter/build.sh",
    "generate:save-fixtures": "cargo run --manifest-path tools/eu5-melter/Cargo.toml --features encoder --bin make-fixtures"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@perspective-dev/client": "^5.5.1",
    "@perspective-dev/react": "^5.5.1",
    "@perspective-dev/viewer": "^5.5.1",
    "@perspective-dev/viewer-charts": "^5.5.1",
    "@perspective-dev/viewer-datagrid": "^5.5.1",
    "apache-arrow": "^17.0.0",
    "brotli-wasm": "^3.0.1",
    "echarts": "^6.1.0",
    "jomini": "^0.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "pngjs": "^7.0.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.140.0"
  }
}
