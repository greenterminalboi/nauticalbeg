ns","targetKey":"byzantine_succession","resolved":true}]},{"category":"government_types","key":"republic","name":"Republic","description":"A $republic$ is a [government_type|e] where the [rulers|e] are chosen by [election|e] to serve as the representants of the citizen body for a set period of time. Depending on the [heir_selection|e] the $game_concept_ruler$ may belong to any of the [estates|e].\n\nThe strength of the political institutions makes Republics more resilient to inheritance issues, but the less personal nature of rule limits the diplomatic tools at their disposal. As such, [dynasties|e] play a lesser role and Republics cannot benefit from [royal_marriages|e].","source":{"kind":"base"},"fields":{"heir_selection":["republic_2_year_terms","republic_4_year_terms","oligarchic_elective","lottery_election","doge_election","peasant_elective","veche_selection","bank_selection","pirate_elective","signoria_selection","diarchic_election","admiralty_regime_heir_selection","general_heir_selection","podesta_elective","military_dictatorship","matrilineal_non_exclusive"],"map_color":"gov_republic","government_power":"republican_tradition","default_character_estate":"burghers_estate","modifier":{"court_language_is_market_language_importance_modifier":3}},"crossRefs":[{"field":"heir_selection.0","targetCategory":"heir_selections","targetKey":"republic_2_year_terms","resolved":true},{"field":"heir_selection.1","targetCategory":"heir_selections","targetKey":"republic_4_year_terms","resolved":true},{"field":"heir_selection.2","targetCategory":"heir_selections","targetKey":"oligarchic_elective","resolved":true},{"field":"heir_selection.3","targetCategory":"heir_selections","targetKey":"lottery_election","resolved":true},{"field":"heir_selection.4","targetCategory":"heir_selections","targetKey":"doge_election","resolved":true},{"field":"heir_selection.5","targetCategory":"heir_selections","targetKey":"peasant_elective","resolved":true},{"field":"heir_selection.6","targetCatego