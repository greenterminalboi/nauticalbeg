[{"category":"government_types","key":"monarchy","name":"Monarchy","description":"A $monarchy$ is a [government_type|e] based upon the principle of undivided personal sovereignty, where the [ruler|e] is the first among the elites. The [heir|e] is normally determined by the [dynasty|e] of the $game_concept_monarch$ and in most cases they rule for life.\n\n$game_concept_monarchs$ can use [royal_marriages|e] to secure [alliances|e], and can even inherit foreign [countries|e] through [personal_unions|e]. However, succession is often a troublesome matter, and Monarchies may easily fall into [regencies|e] or under the influence of foreign $game_concept_dynasties$.","source":{"kind":"base"},"fields":{"use_regnal_number":true,"heir_selection":["cognatic_primogeniture","absolute_cognatic_primogeniture","salic_law","semi_salic_law","partition_inheritance","youngest_son_of_ruler","tanistry_elective","elective_succession","dynastic_elective_succession","favorite_son_elective_succession","admiralty_regime_heir_selection","general_heir_selection","ritual_selection","fratricide_succesion","unigeniture","mamluk_succesion","union_of_crowns_succession","austrian_cognatic_primogeniture","matrilineal_salic_law","judicial_election","matrilineal_non_exclusive","byzantine_succession"],"map_color":"gov_monarchy","government_power":"legitimacy","revolutionary_country_antagonism":20,"default_character_estate":"nobles_estate","modifier":{"care_about_producing_heirs":true}},"crossRefs":[{"field":"heir_selection.0","targetCategory":"heir_selections","targetKey":"cognatic_primogeniture","resolved":true},{"field":"heir_selection.1","targetCategory":"heir_selections","targetKey":"absolute_cognatic_primogeniture","resolved":true},{"field":"heir_selection.2","targetCategory":"heir_selections","targetKey":"salic_law","resolved":true},{"field":"heir_selection.3","targetCategory":"heir_selections","targetKey":"semi_salic_law","resolved":true},{"field":"heir_selection.4","targetCategory":"heir_selection