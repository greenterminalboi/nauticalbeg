,"subtract":"scope:maintenance"},"global_monthly_development":-0.0025}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"central_secretariat_bureaucracy","name":"Central Secretariat","description":"The #italic $zhongshu_sheng$#! was the Yuán dynasty's supreme civil administrative body, directing all governance across the empire from the capital. A well-funded Secretariat legitimizes the dynasty's authority through decisive, coordinated rule — but when its operations are neglected, the resulting administrative chaos raises the cost of every political decision the crown must make.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_or_had_tag":"CHI"},"estates_that_like":["crown_estate","burghers_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"government_size":1},"positive_modifier":{"scale":{"value":"scope:maintenance","if":{"limit":{"root":{"EXISTS":{"has_advance":"zhongshu_sheng"}}},"multiply":1.5}},"monthly_legitimacy":0.2,"monthly_celestial_authority":0.02},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"stability_cost_efficiency":-0.1,"monthly_celestial_authority":-0.04}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"imperial_censorate_bureaucracy","name":"Imperial Censorate","description":"The #italic Yùshǐtái#! under the Yuán — later reformed as the #italic Dūcháyuàn#! under the Míng — was the inspectorate charged with rooting out corruption among officials and ensuring the law was upheld from capital to province. When properly funded, its investigators recover tax income that would otherwise leak away through official misconduct — but left without resources, they lose the reach to act, and estates move swiftly to exploit the oversight vacuum.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_or_had_tag":"CHI"},"estates_that_like":["crown_estate"],"estates_that_dislike":["nobles_estate","burghers_estate"],"neutral_modifier":{"stability_cost_efficiency":0.05},"positive_modifier":{"scale":{"value":"scope:maintenance","if":{"limit":{"root":{"EXISTS":{"has_advance":"the_censorate"}}},"multiply":1.5}},"tax_income_efficiency":0.08,"monthly_celestial_authority":0.02},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"global_estate_power":0.2,"monthly_celestial_authority":-0.04}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"six_boards_bureaucracy","name":"Six Boards","description":"The #italic Liùbù#! were the six ministries of the Míng dynasty — Personnel, Revenue, Rites, War, Justice, and Works — that collectively administered the entire apparatus of the state. Together they represent the most comprehensive bureaucratic structure in the world; well-funded, they deliver a marked increase in tax revenues, but neglected, the six boards become entrenched power bases for factional officials who serve their own interests before the throne's.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_or_had_tag":"CHI"},"estates_that_like":["crown_estate"],"estates_that_dislike":["nobles_estate"],"on_deactivate":{"if":{"limit":{"has_law":"six_ministries_overseer_law"},"custom_tooltip":"six_boards_deactivate_disables_oversight_law_tt"}},"neutral_modifier":{"government_size":2},"positive_modifier":{"scale":{"value":"scope:maintenance","if":[{"limit":{"root":{"EXISTS":{"has_reform":"government_reform:three_departments_system"}}},"multiply":1.5},{"limit":{"root":{"EXISTS":{"has_policy":"chi_grand_secretariat"}}},"multiply":1.2},{"limit":{"root":{"EXISTS":{"has_policy":"chi_direct_report"}}},"multiply":1.1}]},"global_manpower_modifier":0.1,"monthly_celestial_authority":0.02},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"global_estate_power":0.25,"monthly_celestial_authority":-0.03}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"grand_secretariat_bureaucracy","name":"Grand Secretariat","description":"The #italic Nèigé#! was the inner advisory council that in practice governed the Míng empire, drafting edicts, mediating between the Emperor and the outer bureaucracy, and coordinating policy across the $six_boards_bureaucracy$. A properly resourced Grand Secretariat builds imperial prestige through decisive, unified governance — but an underfunded one loses the Emperor's ear, and the legitimacy it was created to sustain begins to erode.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_or_had_tag":"CHI"},"estates_that_like":["crown_estate"],"estates_that_dislike":["burghers_estate"],"neutral_modifier":{"monthly_legitimacy":0.1},"positive_modifier":{"scale":{"value":"scope:maintenance","if":{"limit":{"root":{"EXISTS":{"has_advance":"reform_the_grand_secretariat"}}},"multiply":1.5}},"monthly_prestige":0.3,"monthly_celestial_authority":0.02},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"monthly_legitimacy":-0.2,"monthly_celestial_authority":-0.04}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"board_of_revenue_bureaucracy","name":"Board of Revenue","description":"A centralized body responsible for the collection, assessment, and management of state revenues. Institutions such as the English Board of Treasury or the French #italic Contrôle général des finances#! showed how a well-funded Revenue Board could dramatically increase the crown's income — but a neglected one, riddled with sinecures and corruption, becomes a drain on the very revenues it was created to protect.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate","burghers_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"government_size":1},"positive_modifier":{"scale":{"value":"scope:maintenance"},"tax_income_efficiency":0.1},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"estate_enrichment":0.1}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"privy_council_bureaucracy","name":"Privy Council","description":"An inner council of trusted advisors that acts as the principal instrument of royal government. Bodies such as the English Privy Council or the Spanish #italic Consejo Real#! allowed monarchs to govern effectively by bringing the great offices of state under a single coordinated body. Without adequate support, however, a Privy Council devolves into a forum for factional infighting, alienating the very estates whose cooperation the crown depends upon.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate"],"estates_that_dislike":["burghers_estate"],"neutral_modifier":{"government_size":1},"positive_modifier":{"scale":{"value":"scope:maintenance"},"parliament_base_support":0.2},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"pop_join_rebel_threshold":0.1}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"audit_bureau_bureaucracy","name":"Audit Bureau","description":"A dedicated body charged with scrutinizing public accounts and checking the corrupt practices of officials and tax farmers. Institutions modeled on the French #italic Cour des Comptes#! or the Dutch #italic Rekenkamer#! gave the crown a powerful tool to recover lost revenues and hold administrators accountable. Left underfunded, however, an Audit Bureau loses its independence — entrenched interests fill the vacuum and the tax apparatus is captured by the very parties it was meant to police.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate","burghers_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"revoke_privilege_cost_modifier":-0.25},"positive_modifier":{"scale":{"value":"scope:maintenance"},"global_crown_estate_power":0.1},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"global_estate_target_satisfaction":"medium_permanent_target_satisfaction_penalty"}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"colonial_office_bureaucracy","name":"Colonial Office","description":"A ministry responsible for directing policy toward overseas territories, managing colonial appointments, and overseeing the legal framework of empire. The English Colonial Office, exemplify how organized metropolitan oversight can accelerate the settlement of distant possessions. Without proper resourcing, however, colonial advertisement encourages people to leave our country without giving them better options within our empire.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["burghers_estate","crown_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"colonial_range_modifier":0.25},"positive_modifier":{"scale":{"value":"scope:maintenance"},"colonial_migration_size_modifier":0.2},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"global_migration_attraction":-0.2}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"admiralty_board_bureaucracy","name":"Admiralty Board","description":"A board of commissioners responsible for the administration, supply, and strategic direction of the navy. The British Admiralty and the Spanish #italic Consejo de Guerra#!'s naval arm demonstrated that professional naval administration was as decisive as the ships themselves. A well-maintained Admiralty can grow a large and experienced pool of sailors — but when funding lapses, recruitment continues while training does not, and naval tradition erodes even as the fleet expands.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"monthly_navy_tradition":0.1},"positive_modifier":{"scale":{"value":"scope:maintenance"},"naval_morale_modifier":0.2},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"navy_maintenance_efficiency":-0.2}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"foreign_ministry_bureaucracy","name":"Foreign Ministry","description":"A permanent bureau dedicated to conducting the state's external relations, maintaining a corps of resident ambassadors, and coordinating intelligence from abroad. France's #italic Ministère des Affaires Étrangères#! pioneered the professional diplomatic service that other powers would eventually copy. A properly resourced Foreign Ministry builds prestige through successful negotiation — but an underfunded one produces embarrassments — envoys who cannot afford their households, despatches that go unanswered, and a reputation that suffers accordingly.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate"],"estates_that_dislike":["burghers_estate"],"neutral_modifier":{"max_diplomats":1},"positive_modifier":{"scale":{"value":"scope:maintenance"},"diplomatic_capacity":1},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"diplomatic_reputation":"diplomatic_reputation_severe_penalty"}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"trade_commission_bureaucracy","name":"Trade Commission","description":"A regulatory body tasked with licensing merchants, adjudicating commercial disputes, setting tariffs, and combating smuggling. Institutions such as the British Board of Trade or the oversight councils of the Dutch #italic Vereenigde Oost-Indische Compagnie#! showed how organized state engagement with commerce could transform national prosperity. Without enforcement capacity, however, a Trade Commission becomes toothless — licensed monopolies are evaded, tariff revenues leak away, and the broader trading economy is left worse off than before.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["burghers_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"trade_range_modifier":0.2},"positive_modifier":{"scale":{"value":"scope:maintenance"},"global_merchant_power":0.2},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"burghers_estate_target_satisfaction":-0.2}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"war_council_bureaucracy","name":"War Council","description":"A supreme military committee responsible for the planning, coordination, and oversight of land forces. The Habsburg #italic Hofkriegsrat#! and the British War Office represent different answers to the same problem of how to impose strategic direction on armies too large for any single commander to control alone. A funded War Council produces a steady stream of capable officers — but when its budgets are cut, the institutional machinery that identifies and promotes talent breaks down, and army tradition decays.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["nobles_estate","crown_estate"],"estates_that_dislike":["burghers_estate"],"neutral_modifier":{"army_tradition_from_battle":1},"positive_modifier":{"scale":{"value":"scope:maintenance"},"military_tactics":0.1},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"land_morale_modifier":-0.1}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"ordnance_board_bureaucracy","name":"Board of Ordnance","description":"A specialized department responsible for the manufacture, storage, and supply of artillery, munitions, and field engineering. England's Board of Ordnance and the French #italic Corps Royal de l'Artillerie#! demonstrated that the professionalization of siege warfare required a permanent bureaucratic institution, not improvised contractors. A well-funded Board of Ordnance greatly improves siege capability — but when starved of resources, it turns inward — foundries go unmaintained, magazine inspections are skipped, and the fortresses that the Board was supposed to keep in repair begin to crumble.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate"],"estates_that_dislike":["nobles_estate"],"neutral_modifier":{"artillery_bonus_vs_fort":1},"positive_modifier":{"scale":{"value":"scope:maintenance"},"army_artillery_power":0.1},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"army_artillery_maintenance_cost_modifier":0.2}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]},{"category":"bureaucracies","key":"commissariat_bureaucracy","name":"Commissariat","description":"A logistical branch of the military establishment responsible for provisioning armies in the field with food, forage, clothing, and equipment. The system developed under Louvois for the armies of Louis XIV — later refined into the #italic Intendance#! — showed that an army that fed itself from organized depots could sustain campaigns of a scale and duration impossible for forces that lived off the land. A properly funded Commissariat swells the effective manpower available for campaigning; an underfunded one forces armies to compensate through ruinous private contracts, driving up maintenance costs far beyond what the manpower gain is worth.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.004},"potential":{"has_embraced_institution":"institution:confessionalism"},"estates_that_like":["crown_estate"],"estates_that_dislike":["peasants_estate"],"neutral_modifier":{"supply_depot_capacity":500},"positive_modifier":{"scale":{"value":"scope:maintenance"},"army_logistics_distance_modifier":0.25},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"army_movement_speed":-0.1}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false}]}]