y":"bureaucracies","key":"imperial_senate_bureaucracy","name":"Imperial Senate","description":"Composed of senior dignitaries appointed by imperial authority, the Senate serves as a body of acclamation and counsel. Its assent legitimizes reigns, successions, and major acts, preserving Roman continuity while ensuring that sovereignty remains firmly imperial.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","removal_price":"price:remove_bureaucracy_price","maintenance_price_modifier":{"value":"country_economical_base","multiply":0.003},"potential":{"has_dlc":"d008_fate_of_the_phoenix","OR":{"has_or_had_tag":"BYZ","AND":{"has_or_had_tag":"TRE","has_variable":"tre_unlocked_byz_bureaucracies"}}},"estates_that_like":["nobles_estate"],"estates_that_dislike":["crown_estate"],"neutral_modifier":{"parliament_duration_modifier":0.3},"positive_modifier":{"scale":{"value":"scope:maintenance"},"parliament_base_support":0.075},"negative_modifier":{"scale":{"value":1,"subtract":"scope:maintenance"},"monthly_legitimacy":-0.2,"monthly_republican_tradition":-0.2}},"crossRefs":[{"field":"maintenance_price_modifier.value","targetCategory":"trigger_localization","targetKey":"country_economical_base","resolved":false},{"field":"potential.OR.has_or_had_tag","targetCategory":"customizable_localization","targetKey":"BYZ","resolved":false}]},{"category":"bureaucracies","key":"kephalai_bureaucracy","name":"Kephalai","description":"The #italic Kephalai#! are administrative and legal compendia designed to render imperial governance practicable. Replacing older regional arrangements such as the #italic Katepaníkion#!, they distill law, taxation, and military obligations into standardized directives, ensuring uniform rule across the provinces.","source":{"kind":"base"},"fields":{"implementation_price":"price:implement_bureaucracy_price","maintenance_price":"price:maintain_bureaucracy_price","remova